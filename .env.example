# Slipstream environment configuration
#
# Copy this file to `.env` and fill in the values. Vite only exposes variables
# prefixed with VITE_ to the browser. The app runs in demo mode when these are
# absent, so you can leave them blank during local development.

# --- Supabase (real auth + FMP/Alpaca key proxying) ---
# Project URL + anon (publishable) key from Supabase → Project Settings → API.
# The anon key is safe to ship in the browser; the service-role key is NOT and
# must never be placed here (it goes in the Edge Function secrets instead).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Optional ---
# Set to "true" to route congressional data through the FMP Edge Function proxy
# (keeps the paid FMP key server-side). Requires Supabase configured above.
VITE_USE_BACKEND_PROXY=false
